{
  "name": "parkpilot",
  "version": "0.1.0",
  "description": "Parking-pass market intelligence and arbitrage operations platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-prisma-standalone.js",
    "start": "node scripts/start-server.js",
    "setup": "node scripts/setup.js",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "test": "jest",
    "worker:jobs": "node dist/workers/jobs.js",
    "worker:bullmq": "tsx workers/run-bullmq.ts",
    "normalize-venues": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/normalize-venues.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.0",
    "bullmq": "^5.77.3",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "decimal.js": "^10.4.3",
    "next": "^14.0.0",
    "nodemailer": "^8.0.2",
    "openai": "^6.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
