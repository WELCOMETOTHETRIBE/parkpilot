{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyMaxRetries": 3
  },
  "variables": {
    "NODE_ENV": "production",
    "PRISMA_QUERY_ENGINE_LIBRARY": {
      "description": "Force Prisma to use OpenSSL 3 engine on Railway (set in Dashboard)",
      "value": "/app/node_modules/.prisma/client/libquery_engine-debian-openssl-3.0.x.so.node"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "value": ""
    },
    "SERPAPI_API_KEY": {
      "description": "SerpApi key for search discovery",
      "value": ""
    },
    "APP_BASE_URL": {
      "description": "Base URL of deployed application",
      "value": ""
    },
    "ADMIN_PASSWORD": {
      "description": "Admin password for MVP auth",
      "value": ""
    }
  }
}
